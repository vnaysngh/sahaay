{
  "name": "sahaay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint apps/web scripts/*.ts tests --max-warnings=0",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:check": "tsx scripts/migrate.ts --check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:web": "playwright test",
    "test:provider": "tsx scripts/provider-smoke.ts",
    "test:live-web": "tsx scripts/web-smoke.ts",
    "test:live-multimodal": "tsx scripts/multimodal-smoke.ts",
    "test:live-research": "tsx scripts/research-smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "type": "module"
}
