# Copy only missing settings into .env or .env.local. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/sahaay
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Sarvam transcribes voice in M2. Keep the key server-side.
SARVAM_API_KEY=

# Media is private, outside public/, with a 24-hour expiry.
# SAHAAY_MEDIA_DIR=/absolute/private/path
# Audio decoding requires ffmpeg and ffprobe on PATH, or explicit binary paths:
# FFMPEG_BIN=/path/to/ffmpeg
# FFPROBE_BIN=/path/to/ffprobe
