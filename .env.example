# Copy only missing settings into .env or .env.local. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/sahaay
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Sarvam transcribes voice in M2. Keep the key server-side.
SARVAM_API_KEY=

# Media is private, outside public/, with a 24-hour expiry.
# SAHAAY_MEDIA_DIR=/absolute/private/path
# Audio decoding requires ffmpeg and ffprobe on PATH, or explicit binary paths:
# FFMPEG_BIN=/path/to/ffmpeg
# FFPROBE_BIN=/path/to/ffprobe

# Transactional email for verified sign-in and password recovery (TLS required).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Require verified email in development for testing the deployed flow:
# SAHAAY_REQUIRE_VERIFICATION=1

# Persistent private storage; ledger is kept OUTSIDE database snapshots.
# SAHAAY_DELETION_LEDGER_DIR=/absolute/private/persistent/deletions
# SAHAAY_BACKUP_DIR=/absolute/private/persistent/backups
SAHAAY_BACKUP_KEY=
# Backup key: 32 random bytes encoded as 64 hex characters; never log/commit it.
# Restore only offline into a NEW EMPTY database:
# SAHAAY_RESTORE_DATABASE_URL=
# SAHAAY_RESTORE_OFFLINE=1
# PG_DUMP_BIN=/path/to/pg_dump
# PG_RESTORE_BIN=/path/to/pg_restore

# Set only after verifying these deployment requirements; not needed for local development.
SAHAAY_EMAIL_DELIVERY_VERIFIED=0
SAHAAY_OPERATIONS_VERIFIED=0
SAHAAY_PROCESSORS_REVIEWED=0

# Telegram private-chat pilot, shared Sahaay core via local polling (no webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# TELEGRAM_ADAPTER_URL=http://127.0.0.1:3000/api/telegram

# Durable image Documents: AES-256-GCM key, base64 encoding of 32 random bytes.
# Local development generates a private artifact.key beside the media directory.
# Production: supply this via a secret manager OR an explicit private persistent key file.
# Keep an independent secure key backup; losing the key makes Documents unrecoverable.
SAHAAY_ARTIFACT_KEY=
SAHAAY_ARTIFACT_KEY_FILE=
